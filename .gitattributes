# Anki deck packages are large zip files, so they live in git lfs.
*.apkg filter=lfs diff=lfs merge=lfs -text

# The sqlite files (accents.db, glosses.db) are generated and large, so they
# live in git lfs.
*.db filter=lfs diff=lfs merge=lfs -text

# The lock files are generated: hide their diff on GitHub, and never merge by
# hand.
uv.lock linguist-generated=true -merge
web/app/pubspec.lock linguist-generated=true -merge

# flutter create and flutter upgrade write it.
web/app/.metadata linguist-generated=true

# build_runner writes the *.g.dart files, web/tests/test_dart_api.py writes
# the copy of the OpenAPI schema, and the fixtures are saved responses of the
# server (web/README.md, "The API client and the models").
*.g.dart linguist-generated=true
web/app/test/api/openapi.json linguist-generated=true
web/app/test/api/fixtures/** linguist-generated=true

# The Noto fonts and their license are copies from notofonts.github.io.
web/app/assets/fonts/** linguist-vendored=true

*.ttf binary
*.png binary
