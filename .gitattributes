# The reference clips of the voices (README.md, "Voice") live in git lfs.
*.wav filter=lfs diff=lfs merge=lfs -text

# Anki deck packages are large zip files, so they live in git lfs.
*.apkg filter=lfs diff=lfs merge=lfs -text

# The sqlite data files are binary: no diff, no merge, no change of line ends.
*.db binary

# The lock file is generated: hide its diff on GitHub, and never merge by hand.
uv.lock linguist-generated=true -merge
