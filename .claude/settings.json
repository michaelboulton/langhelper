{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "pub.dev",
        "storage.googleapis.com",
        "registry.npmjs.org",
        "cdn.playwright.dev"
      ]
    }
  }
}
